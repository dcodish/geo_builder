# Geo Builder LLM-fallback proxy (Phase 7) — systemd unit.
#
# Install on themathbible.com:
#   cp deploy/geo-proxy.service /etc/systemd/system/geo-proxy.service
#   systemctl daemon-reload
#   systemctl enable --now geo-proxy
#   systemctl status geo-proxy        # should be active (running)
#
# The API key is NOT in this file — it lives in the root-only EnvironmentFile
# (geo-proxy.env, mode 600). Update the proxy with:
#   scp dist-server/proxy.mjs root@themathbible.com:/var/www/vhosts/themathbible.com/geo-proxy/
#   systemctl restart geo-proxy

[Unit]
Description=Geo Builder LLM-fallback proxy (POST /api/parse)
After=network.target

[Service]
Type=simple
# Use the absolute path to node on the box (check with: which node).
ExecStart=/usr/bin/node /var/www/vhosts/themathbible.com/geo-proxy/proxy.mjs
EnvironmentFile=/var/www/vhosts/themathbible.com/geo-proxy/geo-proxy.env
Environment=PORT=8788
Environment=HOST=127.0.0.1
Restart=on-failure
RestartSec=2
# Hardening: bind loopback only (the reverse proxy reaches it), drop privileges.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
