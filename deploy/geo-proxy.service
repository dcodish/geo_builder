# Geo Builder LLM-fallback proxy (Phase 7) — systemd unit.
#
# Install on themathbible.com:
#   cp deploy/geo-proxy.service /etc/systemd/system/geo-proxy.service
#   systemctl daemon-reload
#   systemctl enable --now geo-proxy
#   systemctl status geo-proxy        # should be active (running)
#
# The API key is NOT in this file — it lives in the root-only EnvironmentFile
# (geo-proxy.env, mode 600; systemd reads it as root, then drops to www-data).
# Update the proxy with:
#   scp dist-server/proxy.mjs root@themathbible.com:/var/www/geo-proxy/
#   systemctl restart geo-proxy

[Unit]
Description=Geo Builder LLM-fallback proxy (POST /api/parse)
After=network.target

[Service]
Type=simple
# Mirrors the box's existing Flask apps (run as www-data). systemd reads the
# EnvironmentFile as root before dropping privileges, so the key file stays
# root-only and www-data never reads it directly.
User=www-data
Group=www-data
ExecStart=/usr/bin/node /var/www/geo-proxy/proxy.mjs
EnvironmentFile=/var/www/geo-proxy/geo-proxy.env
Environment=PORT=8788
Environment=HOST=127.0.0.1
Restart=on-failure
RestartSec=2
# Hardening (SEC-9): bind loopback only (the reverse proxy reaches it), drop privileges, and lock the
# filesystem down. ProtectSystem=strict makes everything read-only EXCEPT the one dir the service must
# write (events.jsonl) — declared in ReadWritePaths. ProtectHome hides /home + /root (incl. any personal
# cloud folders) from the process. The key file (geo-proxy.env) is 600 root:root; systemd reads it as
# root before dropping to www-data, so www-data never reads it directly.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/geo-proxy

[Install]
WantedBy=multi-user.target
