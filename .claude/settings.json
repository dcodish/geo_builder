{
  "autoMemoryDirectory": "C:/projects/geo_builder/.claude/memory",
  "permissions": {
    "allow": [
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue close:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr merge:*)",
      "PowerShell(gh issue create:*)",
      "PowerShell(gh issue edit:*)",
      "PowerShell(gh issue comment:*)",
      "PowerShell(gh issue close:*)",
      "PowerShell(gh pr create:*)",
      "PowerShell(gh pr edit:*)",
      "PowerShell(gh pr comment:*)",
      "PowerShell(gh pr merge:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree prune:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git switch:*)",
      "PowerShell(git checkout -b:*)",
      "PowerShell(git worktree add:*)",
      "PowerShell(git worktree list:*)",
      "PowerShell(git worktree prune:*)",
      "Bash(scp -r dist/* root@themathbible.com:*)",
      "Bash(scp -r dist-3d/* root@themathbible.com:*)",
      "Bash(scp -r dist-complex/* root@themathbible.com:*)",
      "Bash(scp dist-server/proxy.mjs root@themathbible.com:*)",
      "Bash(ssh root@themathbible.com:*)",
      "PowerShell(scp -r dist/* root@themathbible.com:*)",
      "PowerShell(scp -r dist-3d/* root@themathbible.com:*)",
      "PowerShell(scp -r dist-complex/* root@themathbible.com:*)",
      "PowerShell(scp dist-server/proxy.mjs root@themathbible.com:*)",
      "PowerShell(ssh root@themathbible.com:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/session-sync.mjs\" start",
            "timeout": 45,
            "statusMessage": "Syncing with GitHub..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/session-sync.mjs\" end",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/ensure-test-server.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
