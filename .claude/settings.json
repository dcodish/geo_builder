{
  "autoMemoryDirectory": "C:/projects/geo_builder/.claude/memory",
  "permissions": {
    "allow": [
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue close:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr merge:*)",
      "PowerShell(gh issue create:*)",
      "PowerShell(gh issue edit:*)",
      "PowerShell(gh issue comment:*)",
      "PowerShell(gh issue close:*)",
      "PowerShell(gh pr create:*)",
      "PowerShell(gh pr edit:*)",
      "PowerShell(gh pr comment:*)",
      "PowerShell(gh pr merge:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree prune:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git switch:*)",
      "PowerShell(git checkout -b:*)",
      "PowerShell(git worktree add:*)",
      "PowerShell(git worktree list:*)",
      "PowerShell(git worktree prune:*)",
      "Bash(scp -r dist/* root@themathbible.com:/var/www/vhosts/themathbible.com/httpdocs/geo-builder/)",
      "Bash(scp -r dist-3d/* root@themathbible.com:/var/www/vhosts/themathbible.com/httpdocs/3d-builder/)",
      "Bash(scp -r dist-complex/* root@themathbible.com:/var/www/vhosts/themathbible.com/httpdocs/complex-builder/)",
      "Bash(scp -r dist-analytic/* root@themathbible.com:/var/www/vhosts/themathbible.com/httpdocs/analytic-builder/)",
      "Bash(scp dist-server/proxy.mjs root@themathbible.com:/var/www/geo-proxy/)",
      "Bash(ssh root@themathbible.com 'mv -f /var/www/vhosts/themathbible.com/httpdocs/3d-builder/3d.html /var/www/vhosts/themathbible.com/httpdocs/3d-builder/index.html')",
      "Bash(ssh root@themathbible.com 'mv -f /var/www/vhosts/themathbible.com/httpdocs/complex-builder/complex.html /var/www/vhosts/themathbible.com/httpdocs/complex-builder/index.html')",
      "Bash(ssh root@themathbible.com 'mv -f /var/www/vhosts/themathbible.com/httpdocs/analytic-builder/analytic.html /var/www/vhosts/themathbible.com/httpdocs/analytic-builder/index.html')",
      "Bash(ssh root@themathbible.com 'chmod -R a+rX /var/www/vhosts/themathbible.com/httpdocs/geo-builder /var/www/vhosts/themathbible.com/httpdocs/3d-builder /var/www/vhosts/themathbible.com/httpdocs/complex-builder /var/www/vhosts/themathbible.com/httpdocs/analytic-builder')",
      "Bash(ssh root@themathbible.com 'systemctl restart geo-proxy')",
      "Bash(ssh root@themathbible.com 'curl -s http://127.0.0.1:8788/healthz')",
      "Bash(ssh root@themathbible.com 'systemctl is-active geo-proxy')",
      "PowerShell(scp -r dist/* root@themathbible.com:/var/www/vhosts/themathbible.com/httpdocs/geo-builder/)",
      "PowerShell(scp -r dist-3d/* root@themathbible.com:/var/www/vhosts/themathbible.com/httpdocs/3d-builder/)",
      "PowerShell(scp -r dist-complex/* root@themathbible.com:/var/www/vhosts/themathbible.com/httpdocs/complex-builder/)",
      "PowerShell(scp -r dist-analytic/* root@themathbible.com:/var/www/vhosts/themathbible.com/httpdocs/analytic-builder/)",
      "PowerShell(scp dist-server/proxy.mjs root@themathbible.com:/var/www/geo-proxy/)",
      "PowerShell(ssh root@themathbible.com 'mv -f /var/www/vhosts/themathbible.com/httpdocs/3d-builder/3d.html /var/www/vhosts/themathbible.com/httpdocs/3d-builder/index.html')",
      "PowerShell(ssh root@themathbible.com 'mv -f /var/www/vhosts/themathbible.com/httpdocs/complex-builder/complex.html /var/www/vhosts/themathbible.com/httpdocs/complex-builder/index.html')",
      "PowerShell(ssh root@themathbible.com 'mv -f /var/www/vhosts/themathbible.com/httpdocs/analytic-builder/analytic.html /var/www/vhosts/themathbible.com/httpdocs/analytic-builder/index.html')",
      "PowerShell(ssh root@themathbible.com 'chmod -R a+rX /var/www/vhosts/themathbible.com/httpdocs/geo-builder /var/www/vhosts/themathbible.com/httpdocs/3d-builder /var/www/vhosts/themathbible.com/httpdocs/complex-builder /var/www/vhosts/themathbible.com/httpdocs/analytic-builder')",
      "PowerShell(ssh root@themathbible.com 'systemctl restart geo-proxy')",
      "PowerShell(ssh root@themathbible.com 'curl -s http://127.0.0.1:8788/healthz')",
      "PowerShell(ssh root@themathbible.com 'systemctl is-active geo-proxy')"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/issue-create-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/session-sync.mjs\" start",
            "timeout": 45,
            "statusMessage": "Syncing with GitHub..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/session-sync.mjs\" end",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/ensure-test-server.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
