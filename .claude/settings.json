{
  "autoMemoryDirectory": "C:/projects/geo_builder/.claude/memory",
  "permissions": {
    "allow": [
      "Bash(scp -r dist/* root@themathbible.com:*)",
      "Bash(scp -r dist-3d/* root@themathbible.com:*)",
      "Bash(scp dist-server/proxy.mjs root@themathbible.com:*)",
      "Bash(ssh root@themathbible.com:*)",
      "PowerShell(scp -r dist/* root@themathbible.com:*)",
      "PowerShell(scp -r dist-3d/* root@themathbible.com:*)",
      "PowerShell(scp dist-server/proxy.mjs root@themathbible.com:*)",
      "PowerShell(ssh root@themathbible.com:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/session-sync.mjs\" start",
            "timeout": 45,
            "statusMessage": "Syncing with GitHub..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/session-sync.mjs\" end",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/ensure-test-server.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
