node_modules
dist
dist-server
.env
.env.local
*.local

# Editor / atomic-write temp and backup files
*.tmp.*
*~
*.bak
*.swp

# TypeScript incremental build info
*.tsbuildinfo

# Dev debug log (server-written session log; reconstruct figures from it)
logs/
# A dev SERVER's own stdout, when a session redirects `npm run dev` to a file to read the port from.
# Two of these reached `main` before the pattern existed — `git add -A` will pick up anything the
# ignore list does not name, so the list names it.
*.log

# Vite temp config
vite.config.ts.timestamp-*.mjs
# Reports are local scratch (audit dumps, fill orders) — EXCEPT the two test-tier artifacts, which are
# durable project state and must travel between machines like docs/ (ADR-394): the measured tier
# membership that `npm run test:fast` derives its exclusion list from, and the longitudinal record of
# which full-suite failures the fast tier would have missed. Both are low-churn by construction —
# the tier file is rewritten only when membership actually changes, the log only appended on a failure.
reports/*
!reports/test-tiers.json
!reports/tier-catches.jsonl
# #502: the log-triage NEW/carried split must travel between the two PCs. This file holds only HASHED
# row keys + dates — no utterance text — so the privacy posture that keeps `logs/triage-state-*.json`
# out of git is preserved while the "was this already put in front of the operator" answer travels.
!reports/triage-surfaced.json
# #750: reports/suite-verdict.json is deliberately NOT allowlisted. It is per-machine, per-RUN evidence
# ("was the suite green for this exact tree state?"), stamped with the sha it ran against. Committing it
# would churn on every run and — worse — let the other PC's verdict be read as this one's, which is the
# staleness the sha stamp exists to catch.
dist-3d
dist-complex

# Assistant worktrees (stale copies can hold unreadable Dropbox placeholders;
# ignoring the dir also stops git status descending into it)
.claude/worktrees/
# NOTE: .claude/memory/ is deliberately TRACKED (2026-07-23). The project moved out of
# Dropbox to C:\projects, so git is now the ONLY cross-machine sync — auto-memory travels
# via GitHub like docs/, not via Dropbox. (Was gitignored under the old Dropbox scheme.)
