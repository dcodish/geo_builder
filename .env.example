# Phase 7 — LLM fallback (server-side only).
#
# Copy this file to `.env.local` and set your key to enable the natural-language
# fallback: when the deterministic parser can't read an utterance, the dev proxy
# (server/llmProxy.ts -> POST /api/parse) asks Claude (Haiku) to normalise it
# into canonical commands the app re-parses.
#
# This key is read ONLY by the Node dev server, never shipped to the browser
# (ADR-023). `.env.local` is gitignored — do not commit a real key. Restart
# `npm run dev` after setting it.
#
# Get a key at https://console.anthropic.com/ and set a prepaid credit cap +
# spend limit there as the outer cost control.

ANTHROPIC_API_KEY=sk-ant-...

# ── Usage analytics + admin dashboard (production proxy: server/standalone.ts) ──
# Only the standalone production proxy reads these; the dev server (npm run dev)
# does not need them. On the server they live in the root-only env file
# (/var/www/geo-proxy/geo-proxy.env, mode 600), NOT in the client bundle.
#
# IP_HASH_SALT       — salt for the hashed visitor id on /api/log (set ANY long
#                      random string; rotating it resets unique-visitor counts).
# EVENTS_LOG_PATH    — where usage events are appended (default ./logs/events.jsonl;
#                      on the server: /var/www/geo-proxy/events.jsonl).
# ADMIN_USERNAME     — the /admin dashboard login name.
# ADMIN_PASSWORD     — the /admin dashboard password (BLANK = dashboard locked).
# ADMIN_COOKIE_SECRET— signs the admin session cookie (any long random string).
# ADMIN_BASE         — public base path the browser sees (default /geo-builder/admin;
#                      use /admin when hitting the proxy directly in local testing).
IP_HASH_SALT=change-me-random
EVENTS_LOG_PATH=./logs/events.jsonl
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_COOKIE_SECRET=change-me-random
